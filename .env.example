# Domain of the collector; Caddy gets a Let's Encrypt certificate for it (A record → this VM).
DOMAIN=sigmastat.gritsenko.biz
# Sites allowed to post events (comma-separated, exact origins).
ALLOWED_ORIGINS=https://sigma.gritsenko.biz,http://localhost:5380
# Token for /stats/*: openssl rand -hex 24
STATS_TOKEN=change-me
# Delete events and sessions older than this many days on start (0 = keep everything).
RETENTION_DAYS=365
